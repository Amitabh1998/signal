ROCKETRIDE_URI=ws://localhost:5565
ROCKETRIDE_AUTH=
ROCKETRIDE_APIKEY=MYAPIKEY
# The scope and delivery pipelines use OpenRouter's OpenAI-compatible endpoint.
# This variable must be available to the RocketRide engine process.
ROCKETRIDE_OPENROUTER_KEY=

# Optional: enables Signal's local implementation runner for one explicitly trusted repo.
# The runner uses Claude Code (or Codex CLI), then the repository's npm test/build scripts, git push, and gh pr create.
# Never expose this local server to an untrusted network while execution is enabled.
SIGNAL_EXECUTION_ENABLED=0
SIGNAL_EXECUTION_REPO=
# Coding agent for build missions: claude (default, headless Claude Code) or codex.
SIGNAL_EXECUTION_RUNNER=claude
SIGNAL_EXECUTION_BASE=main
# Git remote that receives Signal-generated branches and pull requests.
SIGNAL_EXECUTION_REMOTE=origin
# Use local only for an isolated demo remote that cannot create GitHub pull requests.
# The production/default mode is github.
SIGNAL_EXECUTION_PR_MODE=github

# Optional: after code and quality gates pass, RocketRide runs a separate delivery-review.pipe.
# It receives the approved mission, coding-agent summary, actual patch, and recorded command outputs.
# It advises human pull-request review; it never authorizes a release.
SIGNAL_DELIVERY_REVIEW_ENABLED=0
# Set to 1 only when a pull request must not be opened unless the RocketRide delivery review succeeds.
SIGNAL_DELIVERY_REVIEW_REQUIRED=0

{
  "project_id": "bb28e1ec-1047-470d-8a93-cd8a6e17ee46",
  "version": 1,
  "components": [
    {"id": "delivery_in", "provider": "webhook", "name": "Tested delivery bundle", "config": {"hideForm": true, "mode": "Source", "parameters": {}, "type": "webhook"}, "ui": {"position": {"x": 20, "y": 260}, "nodeType": "default", "formDataValid": true}},
    {"id": "parse_delivery", "provider": "parse", "name": "Parse delivery bundle", "config": {}, "input": [{"lane": "tags", "from": "delivery_in"}], "ui": {"position": {"x": 220, "y": 260}, "nodeType": "default", "formDataValid": true}},
    {"id": "delivery_question", "provider": "question", "name": "Delivery as question", "config": {}, "input": [{"lane": "text", "from": "parse_delivery"}], "ui": {"position": {"x": 420, "y": 260}, "nodeType": "default", "formDataValid": true}},
    {"id": "diff_agent", "provider": "agent_rocketride", "name": "Diff reader agent", "config": {"agent_description": "Read-only diff reader for one committed delivery", "instructions": ["You are the read-only Diff Reader. The delivery bundle names a commitRange with base and head commit ids. Call git_reader.diff with ref_a set to base and ref_b set to head, and git_reader.log with max_count 1 to read the head commit subject. Never call any other tool; you may not modify the repository.", "Reply in plain text. Start with exactly three lines: `git.diff(BASE..HEAD)` using 7-character ids, `commit SHORT \"SUBJECT\"`, and `files changed: N · +ADDED · -REMOVED` taken from the diff result. Then write one line per changed file: `path — what the change does` in at most 20 words, based only on the patch you read."], "max_waves": 6, "require_tool_call": true}, "input": [{"lane": "questions", "from": "delivery_question"}], "ui": {"position": {"x": 640, "y": 260}, "nodeType": "default", "formDataValid": true}},
    {"id": "diff_agent_llm", "provider": "llm_openai_api", "name": "Diff reader model", "config": {"profile": "custom", "custom": {"model": "openai/gpt-4o", "base_url": "https://openrouter.ai/api/v1", "apikey": "${ROCKETRIDE_OPENROUTER_KEY}", "modelTotalTokens": 128000, "modelOutputTokens": 12000}}, "control": [{"classType": "llm", "from": "diff_agent"}], "ui": {"position": {"x": 640, "y": 80}, "nodeType": "default", "formDataValid": true}},
    {"id": "git_reader", "provider": "tool_git", "name": "Read-only git", "config": {"title": "Git", "repoPath": "", "authType": "none", "username": "", "token": "", "sshKey": "", "sshPassphrase": "", "safeMode": true, "readOnlyMode": true}, "control": [{"classType": "tool", "from": "diff_agent"}], "ui": {"position": {"x": 640, "y": 440}, "nodeType": "default", "formDataValid": true}},
    {"id": "diff_memory", "provider": "memory_internal", "name": "Agent memory", "config": {}, "control": [{"classType": "memory", "from": "diff_agent"}], "ui": {"position": {"x": 820, "y": 440}, "nodeType": "default", "formDataValid": true}},
    {"id": "diff_document", "provider": "answer_documents", "name": "Diff reading", "config": {}, "input": [{"lane": "answers", "from": "diff_agent"}], "ui": {"position": {"x": 860, "y": 260}, "nodeType": "default", "formDataValid": true}},
    {"id": "change_prompt", "provider": "prompt", "name": "Change reviewer brief", "config": {"instructions": ["You are the Change Reviewer role. Your promise is to compare the approved mission and acceptance criteria with the Diff Reader agent's reading of the committed diff. Identify mismatches, missing acceptance criteria, unsafe changes, and unknowns. Each numberedDiff line in the delivery bundle starts with its new-file location as path:line; cite evidence in exactly that path:line form (for example src/app.js:41), using only locations printed in numberedDiff. Use only the supplied delivery bundle and the Diff Reader's output. The Diff Reader agent read this commit with read-only git tools; numberedDiff is the same commit with line locations. Never claim that code outside numberedDiff was inspected. Return compact JSON with role, promise, findings, risks, and evidence_links."]}, "input": [{"lane": "text", "from": "parse_delivery"}, {"lane": "documents", "from": "diff_document"}], "ui": {"position": {"x": 1080, "y": 70}, "nodeType": "default", "formDataValid": true}},
    {"id": "quality_prompt", "provider": "prompt", "name": "Quality gatekeeper brief", "config": {"instructions": ["You are the Quality Gatekeeper role. Your promise is to assess only the recorded qualityGates commands, statuses, and captured outputs in the delivery bundle. Identify missing acceptance-test coverage and failed or absent checks. Do not infer correctness or release safety from a passing command. Return compact JSON with role, promise, findings, risks, and evidence_links."]}, "input": [{"lane": "text", "from": "parse_delivery"}, {"lane": "documents", "from": "diff_document"}], "ui": {"position": {"x": 1080, "y": 260}, "nodeType": "default", "formDataValid": true}},
    {"id": "release_prompt", "provider": "prompt", "name": "Release skeptic brief", "config": {"instructions": ["You are the Release Skeptic role. Your promise is to surface unresolved release risk, operational unknowns, and exact areas a human should inspect in the committed diff. Each numberedDiff line in the delivery bundle starts with its new-file location as path:line; cite evidence in exactly that path:line form (for example src/app.js:41), using only locations printed in numberedDiff. Use only the supplied delivery bundle and the Diff Reader's output. Never approve a release. Return compact JSON with role, promise, findings, risks, and evidence_links."]}, "input": [{"lane": "text", "from": "parse_delivery"}, {"lane": "documents", "from": "diff_document"}], "ui": {"position": {"x": 1080, "y": 450}, "nodeType": "default", "formDataValid": true}},
    {"id": "change_llm", "provider": "llm_openai_api", "name": "Change reviewer", "config": {"profile": "custom", "custom": {"model": "openai/gpt-4o-mini", "base_url": "https://openrouter.ai/api/v1", "apikey": "${ROCKETRIDE_OPENROUTER_KEY}", "modelTotalTokens": 128000, "modelOutputTokens": 4096}}, "input": [{"lane": "questions", "from": "change_prompt"}], "ui": {"position": {"x": 860, "y": 70}, "nodeType": "default", "formDataValid": true}},
    {"id": "quality_llm", "provider": "llm_openai_api", "name": "Quality gatekeeper", "config": {"profile": "custom", "custom": {"model": "openai/gpt-4o-mini", "base_url": "https://openrouter.ai/api/v1", "apikey": "${ROCKETRIDE_OPENROUTER_KEY}", "modelTotalTokens": 128000, "modelOutputTokens": 4096}}, "input": [{"lane": "questions", "from": "quality_prompt"}], "ui": {"position": {"x": 860, "y": 260}, "nodeType": "default", "formDataValid": true}},
    {"id": "release_llm", "provider": "llm_openai_api", "name": "Release skeptic", "config": {"profile": "custom", "custom": {"model": "openai/gpt-4o-mini", "base_url": "https://openrouter.ai/api/v1", "apikey": "${ROCKETRIDE_OPENROUTER_KEY}", "modelTotalTokens": 128000, "modelOutputTokens": 4096}}, "input": [{"lane": "questions", "from": "release_prompt"}], "ui": {"position": {"x": 860, "y": 450}, "nodeType": "default", "formDataValid": true}},
    {"id": "change_document", "provider": "answer_documents", "name": "Change assessment", "config": {}, "input": [{"lane": "answers", "from": "change_llm"}], "ui": {"position": {"x": 1080, "y": 70}, "nodeType": "default", "formDataValid": true}},
    {"id": "quality_document", "provider": "answer_documents", "name": "Quality assessment", "config": {}, "input": [{"lane": "answers", "from": "quality_llm"}], "ui": {"position": {"x": 1080, "y": 260}, "nodeType": "default", "formDataValid": true}},
    {"id": "release_document", "provider": "answer_documents", "name": "Release assessment", "config": {}, "input": [{"lane": "answers", "from": "release_llm"}], "ui": {"position": {"x": 1080, "y": 450}, "nodeType": "default", "formDataValid": true}},
    {"id": "synthesis_prompt", "provider": "prompt", "name": "Delivery reconciliation", "config": {"instructions": ["Reconcile the three specialist delivery assessments against the supplied bundle. Promise Theory here means each role is assessed only on its bounded review promise. Semantic Spacetime here means every finding must name its supplied artifact or recorded command as evidence; it does not establish causality. A passing test/build does not authorize release. Return only valid JSON with exactly: {schemaVersion,mode,reviewId,generatedAt,verdict,summary,checks,risks,promises,trace}. verdict is ready, needs-review, or blocked. ready means only ready for human pull-request review, never automatic release. checks is [{name,status,detail,evidence}], status is passed, failed, missing, or review. risks is [{title,severity,detail,evidence}], severity is low, medium, high. A check about a recorded command (tests, build, setup) cites that command and its recorded output, never a file location. Every risk, and every check that concerns code, must include in its evidence at least one path:line location printed in numberedDiff (for example src/app.js:41) that the specialists cited. promises is [{agent,body,assessment}], assessment is kept, qualified, or broken. trace is [{from,to,kind}], kind is supports or challenges. Use reviewId signal_delivery_live and ISO 8601 generatedAt. Do not invent tests, diffs, deployments, source files, or approvals."]}, "input": [{"lane": "text", "from": "parse_delivery"}, {"lane": "documents", "from": "change_document"}, {"lane": "documents", "from": "quality_document"}, {"lane": "documents", "from": "release_document"}, {"lane": "documents", "from": "diff_document"}], "ui": {"position": {"x": 1310, "y": 260}, "nodeType": "default", "formDataValid": true}},
    {"id": "synthesis_llm", "provider": "llm_openai_api", "name": "Delivery synthesis", "config": {"profile": "custom", "custom": {"model": "openai/gpt-4o-mini", "base_url": "https://openrouter.ai/api/v1", "apikey": "${ROCKETRIDE_OPENROUTER_KEY}", "modelTotalTokens": 128000, "modelOutputTokens": 4096}}, "input": [{"lane": "questions", "from": "synthesis_prompt"}], "ui": {"position": {"x": 1530, "y": 260}, "nodeType": "default", "formDataValid": true}},
    {"id": "synthesis_document", "provider": "answer_documents", "name": "Delivery synthesis document", "config": {}, "input": [{"lane": "answers", "from": "synthesis_llm"}], "ui": {"position": {"x": 1730, "y": 200}, "nodeType": "default", "formDataValid": true}},
    {"id": "review_extractor", "provider": "extract_data", "name": "Enforce delivery review contract", "config": {"profile": "default", "fields": [{"column": "schemaVersion", "type": "int", "defval": "1"}, {"column": "mode", "type": "text", "defval": "live"}, {"column": "reviewId", "type": "text", "defval": "signal_delivery_live"}, {"column": "generatedAt", "type": "datetime", "defval": ""}, {"column": "verdict", "type": "text", "defval": "needs-review"}, {"column": "summary", "type": "text", "defval": ""}, {"column": "checks", "type": "json", "defval": "[]"}, {"column": "risks", "type": "json", "defval": "[]"}, {"column": "promises", "type": "json", "defval": "[]"}, {"column": "trace", "type": "json", "defval": "[]"}]}, "input": [{"lane": "documents", "from": "synthesis_document"}], "ui": {"position": {"x": 1930, "y": 200}, "nodeType": "default", "formDataValid": true}},
    {"id": "formatter_llm", "provider": "llm_openai_api", "name": "Delivery formatter", "config": {"profile": "custom", "custom": {"model": "openai/gpt-4o-mini", "base_url": "https://openrouter.ai/api/v1", "apikey": "${ROCKETRIDE_OPENROUTER_KEY}", "modelTotalTokens": 128000, "modelOutputTokens": 4096}}, "control": [{"classType": "llm", "from": "review_extractor"}], "ui": {"position": {"x": 1930, "y": 380}, "nodeType": "default", "formDataValid": true}},
    {"id": "delivery_response", "provider": "response_answers", "name": "Delivery review", "config": {"laneName": "answers"}, "input": [{"lane": "answers", "from": "review_extractor"}], "ui": {"position": {"x": 2150, "y": 200}, "nodeType": "default", "formDataValid": true}}
  ],
  "viewport": {"x": 0, "y": 0, "zoom": 0.75}
}

{
  "project_id": "bb28e1ec-1047-470d-8a93-cd8a6e17ee46",
  "version": 1,
  "components": [
    { "id": "delivery_in", "provider": "webhook", "name": "Tested delivery bundle", "config": { "hideForm": true, "mode": "Source", "parameters": {}, "type": "webhook" }, "ui": { "position": { "x": 20, "y": 260 }, "nodeType": "default", "formDataValid": true } },
    { "id": "parse_delivery", "provider": "parse", "name": "Parse delivery bundle", "config": {}, "input": [{ "lane": "tags", "from": "delivery_in" }], "ui": { "position": { "x": 220, "y": 260 }, "nodeType": "default", "formDataValid": true } },
    { "id": "delivery_question", "provider": "question", "name": "Delivery as question", "config": {}, "input": [{ "lane": "text", "from": "parse_delivery" }], "ui": { "position": { "x": 420, "y": 260 }, "nodeType": "default", "formDataValid": true } },
    { "id": "change_prompt", "provider": "prompt", "name": "Change reviewer brief", "config": { "instructions": ["You are the Change Reviewer role. Your promise is to compare the approved mission with the reported implementation and diff summary. Identify mismatches, missing acceptance criteria, or unknowns. Use only the supplied delivery bundle. Never claim that code was inspected unless the bundle includes it. Return compact JSON with role, promise, findings, risks, and evidence_links."] }, "input": [{ "lane": "questions", "from": "delivery_question" }], "ui": { "position": { "x": 640, "y": 70 }, "nodeType": "default", "formDataValid": true } },
    { "id": "quality_prompt", "provider": "prompt", "name": "Quality gatekeeper brief", "config": { "instructions": ["You are the Quality Gatekeeper role. Your promise is to assess only the recorded test and build outcomes, including missing or failed checks. Do not infer coverage, correctness, or release safety from a passing command. Return compact JSON with role, promise, findings, risks, and evidence_links."] }, "input": [{ "lane": "questions", "from": "delivery_question" }], "ui": { "position": { "x": 640, "y": 260 }, "nodeType": "default", "formDataValid": true } },
    { "id": "release_prompt", "provider": "prompt", "name": "Release skeptic brief", "config": { "instructions": ["You are the Release Skeptic role. Your promise is to surface unresolved release risk, operational unknowns, and reasons a human reviewer should inspect the diff. Use only the supplied delivery bundle. Never approve a release. Return compact JSON with role, promise, findings, risks, and evidence_links."] }, "input": [{ "lane": "questions", "from": "delivery_question" }], "ui": { "position": { "x": 640, "y": 450 }, "nodeType": "default", "formDataValid": true } },
    { "id": "change_llm", "provider": "llm_openai", "name": "Change reviewer", "config": { "profile": "openai-4o-mini", "openai-4o-mini": { "apikey": "${ROCKETRIDE_OPENAI_KEY}" }, "temperature": 0, "parameters": {} }, "input": [{ "lane": "questions", "from": "change_prompt" }], "ui": { "position": { "x": 860, "y": 70 }, "nodeType": "default", "formDataValid": true } },
    { "id": "quality_llm", "provider": "llm_openai", "name": "Quality gatekeeper", "config": { "profile": "openai-4o-mini", "openai-4o-mini": { "apikey": "${ROCKETRIDE_OPENAI_KEY}" }, "temperature": 0, "parameters": {} }, "input": [{ "lane": "questions", "from": "quality_prompt" }], "ui": { "position": { "x": 860, "y": 260 }, "nodeType": "default", "formDataValid": true } },
    { "id": "release_llm", "provider": "llm_openai", "name": "Release skeptic", "config": { "profile": "openai-4o-mini", "openai-4o-mini": { "apikey": "${ROCKETRIDE_OPENAI_KEY}" }, "temperature": 0, "parameters": {} }, "input": [{ "lane": "questions", "from": "release_prompt" }], "ui": { "position": { "x": 860, "y": 450 }, "nodeType": "default", "formDataValid": true } },
    { "id": "change_document", "provider": "answer_documents", "name": "Change assessment", "config": {}, "input": [{ "lane": "answers", "from": "change_llm" }], "ui": { "position": { "x": 1080, "y": 70 }, "nodeType": "default", "formDataValid": true } },
    { "id": "quality_document", "provider": "answer_documents", "name": "Quality assessment", "config": {}, "input": [{ "lane": "answers", "from": "quality_llm" }], "ui": { "position": { "x": 1080, "y": 260 }, "nodeType": "default", "formDataValid": true } },
    { "id": "release_document", "provider": "answer_documents", "name": "Release assessment", "config": {}, "input": [{ "lane": "answers", "from": "release_llm" }], "ui": { "position": { "x": 1080, "y": 450 }, "nodeType": "default", "formDataValid": true } },
    { "id": "synthesis_prompt", "provider": "prompt", "name": "Delivery reconciliation", "config": { "instructions": ["Reconcile the three specialist delivery assessments against the supplied bundle. Promise Theory here means each role is assessed only on its bounded review promise. Semantic Spacetime here means every finding must name its supplied artifact or recorded command as evidence; it does not establish causality. A passing test/build does not authorize release. Return only valid JSON with exactly: {schemaVersion,mode,reviewId,generatedAt,verdict,summary,checks,risks,promises,trace}. verdict is ready, needs-review, or blocked. ready means only ready for human pull-request review, never automatic release. checks is [{name,status,detail,evidence}], status is passed, failed, missing, or review. risks is [{title,severity,detail,evidence}], severity is low, medium, high. promises is [{agent,body,assessment}], assessment is kept, qualified, or broken. trace is [{from,to,kind}], kind is supports or challenges. Use reviewId signal_delivery_live and ISO 8601 generatedAt. Do not invent tests, diffs, deployments, source files, or approvals."] }, "input": [{ "lane": "questions", "from": "delivery_question" }, { "lane": "documents", "from": "change_document" }, { "lane": "documents", "from": "quality_document" }, { "lane": "documents", "from": "release_document" }], "ui": { "position": { "x": 1310, "y": 260 }, "nodeType": "default", "formDataValid": true } },
    { "id": "synthesis_llm", "provider": "llm_openai", "name": "Delivery synthesis", "config": { "profile": "openai-4o-mini", "openai-4o-mini": { "apikey": "${ROCKETRIDE_OPENAI_KEY}" }, "temperature": 0, "parameters": {} }, "input": [{ "lane": "questions", "from": "synthesis_prompt" }], "ui": { "position": { "x": 1530, "y": 260 }, "nodeType": "default", "formDataValid": true } },
    { "id": "synthesis_document", "provider": "answer_documents", "name": "Delivery synthesis document", "config": {}, "input": [{ "lane": "answers", "from": "synthesis_llm" }], "ui": { "position": { "x": 1730, "y": 200 }, "nodeType": "default", "formDataValid": true } },
    { "id": "review_extractor", "provider": "extract_data", "name": "Enforce delivery review contract", "config": { "profile": "default", "fields": [{ "column": "schemaVersion", "type": "int", "defval": "1" }, { "column": "mode", "type": "text", "defval": "live" }, { "column": "reviewId", "type": "text", "defval": "signal_delivery_live" }, { "column": "generatedAt", "type": "datetime", "defval": "" }, { "column": "verdict", "type": "text", "defval": "needs-review" }, { "column": "summary", "type": "text", "defval": "" }, { "column": "checks", "type": "json", "defval": "[]" }, { "column": "risks", "type": "json", "defval": "[]" }, { "column": "promises", "type": "json", "defval": "[]" }, { "column": "trace", "type": "json", "defval": "[]" }] }, "input": [{ "lane": "documents", "from": "synthesis_document" }], "ui": { "position": { "x": 1930, "y": 200 }, "nodeType": "default", "formDataValid": true } },
    { "id": "formatter_llm", "provider": "llm_openai", "name": "Delivery formatter", "config": { "profile": "openai-4o-mini", "openai-4o-mini": { "apikey": "${ROCKETRIDE_OPENAI_KEY}" }, "temperature": 0, "parameters": {} }, "control": [{ "classType": "llm", "from": "review_extractor" }], "ui": { "position": { "x": 1930, "y": 380 }, "nodeType": "default", "formDataValid": true } },
    { "id": "delivery_response", "provider": "response_answers", "name": "Delivery review", "config": { "laneName": "answers" }, "input": [{ "lane": "answers", "from": "review_extractor" }], "ui": { "position": { "x": 2150, "y": 200 }, "nodeType": "default", "formDataValid": true } }
  ],
  "viewport": { "x": 0, "y": 0, "zoom": 0.75 }
}
